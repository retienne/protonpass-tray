# A systemd *user* unit: install to /usr/lib/systemd/user/ (package) or
# ~/.config/systemd/user/ (by hand), then `systemctl --user enable protonpass-tray.service`.
[Unit]
Description=Proton Pass session lock tray
Documentation=https://github.com/retienne/protonpass-tray
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=protonpass-tray tray
Restart=on-failure
RestartSec=10
# No credentials of any kind are held by this process: the lock code is passed to pass-cli and
# dropped. Nothing here needs to outlive the session.
Slice=app.slice

[Install]
WantedBy=graphical-session.target
